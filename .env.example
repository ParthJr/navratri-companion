# =============================================================================
# NAVRATRI COMPANION - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env.local for local development.
# For Vercel deployment, enter these variables into:
#   Project Settings -> Environment Variables -> Production
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit secrets or service role keys to Git.
# - SUPABASE_SERVICE_ROLE_KEY and MASTER_ADMIN_PASSWORD must remain SERVER-ONLY.
# - Do NOT prefix secrets with VITE_ to prevent bundling into client-side code.
# =============================================================================

# --- SUPABASE DATABASE CONFIGURATION (Required) ---
# Your Supabase Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for browser client)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase Service Role Secret Key (CRITICAL: SERVER-ONLY!)
# Found in Supabase Dashboard -> Settings -> API -> Project API Keys -> service_role (secret)
# Required by backend API handlers to bypass RLS for payment verification and approvals.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# --- MASTER ADMIN AUTHENTICATION (Required) ---
# Master admin credentials used for Super Admin Dashboard login
MASTER_ADMIN_EMAIL=admin@navratricompanion.com
# Strong master admin password. Must match what the Super Admin enters.
MASTER_ADMIN_PASSWORD=change_this_to_a_strong_secret_password

# --- JWT / SESSION SECURITY (Required) ---
# Random 64+ char secret string used to sign session tokens and admin cookies
JWT_SECRET=generate_a_secure_random_64_character_hex_or_string_here

# --- UPI PAYMENT CONFIGURATION (Optional / Overrides) ---
# Platform receiver UPI ID for the ₹499 registration fee
VITE_UPI_ID=9974203300@okbizaxis
VITE_UPI_NAME=Navratri Companion

# --- WHATSAPP SUPPORT CONFIGURATION ---
# Format: International phone number digits only without +, spaces, or dashes (e.g. 919876543210)
VITE_WHATSAPP_NUMBER=919876543210
VITE_WHATSAPP_DEFAULT_MESSAGE="Hello Navratri Companion team, I need help with the platform."

# --- NODE ENVIRONMENT ---
NODE_ENV=production

